{
  "experiment": "zero_shot",
  "prompt_version": "v4",
  "prompt_version_note": "v4: prompts are language-neutral templates ({language} is filled from the language config); adds the single-call step-by-step prompt. For Korean the filled prompts are identical to v3 (all-in-one) and to the earlier two-call prompts, which are kept as 'two_stage' (renamed files).",
  "prompt_source": "Korean IGT Experimental Protocol V3, section 2 (agenda 17 Nov); step-by-step = one call that asks for step 1 then step 2 (tutor, 20 Nov)",
  "models": [
    {
      "size": "1B",
      "model_id": "allenai/Bolmo-1B",
      "revision": "452690a8cfab1dd1ec27b74f2667632f17a21b46"
    }
  ],
  "dataset_manifest": "data/manifest.json",
  "eval_split": "test",
  "smoke_test": {
    "split": "dev",
    "limit": 10
  },
  "strategies": [
    "all_in_one",
    "step_by_step",
    "two_stage"
  ],
  "prompts": {
    "all_in_one": "zero_shot/prompts/all_in_one.txt",
    "step_by_step": "zero_shot/prompts/step_by_step.txt",
    "step_1_transliteration": "zero_shot/prompts/two_stage_transliteration.txt",
    "step_2_gloss": "zero_shot/prompts/two_stage_gloss.txt"
  },
  "languages": {
    "korean": {
      "language_name": "Korean",
      "dataset_manifest": "data/manifest.json",
      "output_dir": "results/zero_shot/korean"
    },
    "ainu": {
      "language_name": "Ainu",
      "dataset_manifest": "data/manifest_ainu.json",
      "output_dir": "results/zero_shot/ainu"
    }
  },
  "input_fields": {
    "original_script": "text",
    "translation": "translation"
  },
  "gold_fields": {
    "transliteration": "transcription",
    "gloss": "glosses"
  },
  "generation": {
    "do_sample": false,
    "num_beams": 1,
    "max_new_tokens": 768,
    "max_new_tokens_unit": "bytes (Bolmo is byte-level)",
    "stop_rule": "single-answer prompts: first complete line; all-in-one and step-by-step: transliteration line + gloss line"
  },
  "seed": 42,
  "save_raw_outputs": true
}
